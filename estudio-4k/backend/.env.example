# Copiar a .env y completar con valores reales. Nunca commitear el .env real.

# Base de datos
DATABASE_URL=postgresql://postgres:password@localhost:5432/estudio4k_db

# Servidor
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Autenticación
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=10

# Cifrado de tokens de Facebook guardados en la base de datos (32 bytes en hex = 64 caracteres)
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=change_this_to_a_64_char_hex_string

# Higgsfield.ai
HIGGSFIELD_API_KEY=your_higgsfield_api_key_here
HIGGSFIELD_BASE_URL=https://api.higgsfield.ai/v1
HIGGSFIELD_WORKSPACE_ID=your_workspace_id

# Meta Graph API (usado como fallback/valor por defecto; cada cuenta conectada
# desde el panel guarda su propio access_token — ver tabla fb_ad_accounts)
FB_APP_ID=your_facebook_app_id
FB_APP_SECRET=your_facebook_app_secret
FB_GRAPH_API_VERSION=v21.0

# Todomotos
COMPANY_NAME=Todomotos S.A. de C.V.
COMPANY_COUNTRY=Honduras
COMPANY_TIMEZONE=America/Tegucigalpa
DEFAULT_CURRENCY=HNL
